{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "vistadex",
  "main": "worker/index.js",
  "compatibility_date": "2025-07-01",
  "assets": {
    "directory": "./prototype",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEMO_MODE_DEFAULT": "auto"
  }
}
