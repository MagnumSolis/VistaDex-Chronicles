# Copy to .env (local) or set as Cloudflare Worker secrets. Never commit real values.
# All keys are optional: with none set, the pipeline runs the key-free mock path.

# LLM — Groq (default/bulk) and Mistral (quality stages)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_SMALL_MODEL=mistral-small-latest
MISTRAL_OBJECTOR_MODEL=mistral-medium-latest

# Web retrieval — TinyFish Search + Fetch
TINYFISH_API_KEY=

# Research data export (Worker only): bearer token for GET /export
EXPORT_TOKEN=
