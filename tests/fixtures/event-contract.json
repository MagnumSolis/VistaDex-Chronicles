  "panel_viewed_rule": {
    "2026-10-pilot-1": "IntersectionObserver threshold 0.5 of the panel's own height. A panel taller than twice the viewport never reported (measurement bug).",
    "2026-10-pilot-2": "A panel counts as viewed when at least 50% of its own height OR at least 50% of the viewport is covered by it (web/src/study/viewRule.ts). Event names and payload fields unchanged. Checked by web/scripts/parity.mjs (tall-panel check at 320x400) and web/src/study/viewRule.test.ts."
  },
  "rules": {
    "section_time": "Time a report section is in view by the panel-viewed rule (\u2265 50% of the section OR \u2265 50% of the viewport), summed per run and section, sent when the report ends (new run, page hidden, withdrawn). Only while the tab is visible and the report screen is shown.",
    "screen_time": "Visible time on a screen, sent when the visitor leaves it or the page is hidden.",
    "field_edited": "Sent when a text field loses focus; carries the length only, never the text.",
    "uploads": "Batched: at most one /events request per 10 s while events arrive, at most 200 events per request, plus a beacon on page hide (Worker limits: 60 requests/min/IP, 200 events/request).",
    "run_started": "Lengths of the five text fields and the selected industries, role and markets; never the text.",
    "select": "A <select> logs control_pressed with its new value on change."
  },
