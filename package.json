{
  "name": "vistadex-prototype",
  "private": true,
  "type": "module",
  "description": "VistaDex idea screener — pipeline core, proxy and tests (no runtime dependencies). Frontend: web/.",
  "scripts": {
    "serve": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test": "node --import ./tests/setup/network-guard.js --test \"tests/*.test.js\"",
    "test:web": "npm --prefix web test",
    "parity": "npm --prefix web run parity",
    "dev-proxy": "node scripts/dev-proxy.js",
    "a11y": "npm --prefix web run a11y",
    "prelaunch": "node scripts/prelaunch.js"
  }
}
